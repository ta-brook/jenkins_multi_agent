# Copy to .env and edit before `docker compose up`.

# Controller
JENKINS_URL=http://localhost:8080
JENKINS_ADMIN_PASSWORD=change-me
# Optional HTTPS (see ../security/gen-controller-keystore.sh, keystore at ./https):
# JENKINS_OPTS=--httpsPort=8443 --httpsKeyStore=/var/jenkins_home/https/keystore.p12 --httpsKeyStorePassword=...

# SCM repo holding the top-level Jenkinsfile. The seed job clones this.
GIT_REPO_URL=

# Local registry (harness service). Production: point at your registry.
REGISTRY_URL=http://registry:5000
REGISTRY_HOST=registry:5000

# Docker hosts (local harness default: tcp://docker-host-a:2375 / docker-host-b:2375)
# Real hosts: tcp://<host-ip>:2376 and enable TLS + real credentials.
DOCKER_HOST_A_URI=tcp://docker-host-a:2375
DOCKER_HOST_B_URI=tcp://docker-host-b:2375
DOCKER_HOST_A_USERNAME=
DOCKER_HOST_A_PASSWORD=
DOCKER_HOST_B_USERNAME=
DOCKER_HOST_B_PASSWORD=

# Registry (per-env passwords, one per environment)
REGISTRY_USERNAME=
REGISTRY_PASSWORD_DEV=
REGISTRY_PASSWORD_STAGING=
REGISTRY_PASSWORD_PROD=

# Deploy tokens (per environment, injected at deploy time only)
DEPLOY_TOKEN_DEV=
DEPLOY_TOKEN_STAGING=
DEPLOY_TOKEN_PROD=

# Agent images (build once via ./jenkins/agents/build-agent-images.sh).
# docker-build runs the sample-app build+test; the env agents run deploys.
AGENT_IMAGE_TOOL_BUILD=registry:5000/jenkins-multi-agent/tool-build:latest
AGENT_IMAGE_DEV=registry:5000/jenkins-multi-agent/tool-deploy:latest
AGENT_IMAGE_STAGING=registry:5000/jenkins-multi-agent/tool-deploy:latest
AGENT_IMAGE_PROD=registry:5000/jenkins-multi-agent/tool-deploy:latest
